---
/**
 * The TDS closing bar — a thin wrapper around the ONE shared component every
 * example site embeds: `<tds-brand-bar>`, served from
 * https://tracht-digital.de/embed/tds-brand-bar.js (source:
 * tds-landingpage-frontend, public/embed/tds-brand-bar.js).
 *
 * The bar used to be copied into each demo by hand, and the copies drifted
 * apart (labels, sizes, links). Do not bring the markup or its styles back
 * here — change the shared file instead, and every demo follows.
 *
 * The link inside is the fallback without JavaScript; the component renders
 * its own copy in Shadow DOM once the script has run. A classic script, so it
 * needs no CORS header.
 */
import type { Locale } from '../lib/types';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<tds-brand-bar lang={locale}>
  <a href={locale === 'en' ? 'https://tracht-digital.de/en/' : 'https://tracht-digital.de/'}>
    {
      locale === 'en'
        ? 'Design & development: Tracht Digital Solutions'
        : 'Design & digitale Umsetzung: Tracht Digital Solutions'
    }
  </a>
</tds-brand-bar>
<script is:inline src="https://tracht-digital.de/embed/tds-brand-bar.js" defer></script>
